VITE_RESEARCH_ENDPOINT=/api/research
VITE_SEGMENTATION_ENDPOINT=/agent/segment
VLM_API_KEY=
VLM_BASE_URL=
VLM_MODEL=
VLM_REASONING_EFFORT=low
RESEARCH_AGENT_ENDPOINT=http://127.0.0.1:8791/agent/research
AGENT_PORT=8791
RESEARCH_TIMEOUT_MS=180000
HOWMUCH_PHONE_ORIGIN=
HOWMUCH_PHONE_PORT=8443
HOWMUCH_TLS_CERT=
HOWMUCH_TLS_KEY=

# Optional: one-tap "Star on GitHub" (OAuth App with device flow enabled, scope public_repo). Without it the star button opens the repo page.
GITHUB_CLIENT_ID=

# Optional: reverse image search lead for the research agents (Google Cloud Vision, Web Detection). Needs the Vision API enabled.
# Off until a person turns it on in Settings > Advanced; their cut-out photo is then sent to Google. HOWMUCH_IMAGE_SEARCH=off disables it on the server.
GOOGLE_VISION_API_KEY=
